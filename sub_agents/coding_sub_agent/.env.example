OPENAI_API_KEY=
E2B_API_KEY=
E2B_TEMPLATE_NAME=forecasting-platform-ds
E2B_TEMPLATE_ID=
CODING_MODEL=gpt-4o-mini
# Last permitted CodeGen only (attempt count == MAX_CODEGEN_ATTEMPTS). Empty = always use CODING_MODEL.
CODING_MODEL_LAST_ATTEMPT=
CODE_JUDGE_MODEL=gpt-4o-mini
IO_JUDGE_MODEL=gpt-4o-mini
MAX_CODEGEN_ATTEMPTS=3
E2B_SANDBOX_TIMEOUT_SECONDS=120
E2B_EXECUTION_TIMEOUT_SECONDS=120
# false = leave sandboxes in E2B UI for debugging; true = kill after each E2BExecute (production)
E2B_KILL_SANDBOX=false
