# --- Secrets — NEVER commit real keys or tokens ---
# Block all env files; only the tracked template is allowed (see exception below).
.env
**/.env
*.env
.env.*
!.env.example
!**/.env.example

# Sub-agent secrets (copy from .env.example; never commit real keys)
#   sub_agents/planner_sub_agent/.env
#   sub_agents/coding_sub_agent/.env

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Distribution / packaging ---
dist/
build/
*.egg-info/
*.egg

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/

# --- Office / docs (local guides) ---
*.docx

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# --- Semgrep local cache (coding sub-agent) ---
.semgrep/

# --- Generated artifacts (plots, exports; not source) ---
artifact/

# --- Agent workspace (runtime data, not source) ---
agent_filesystem/

# --- Logs ---
*.log
logs/
