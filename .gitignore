# --- Secrets — NEVER commit real keys or tokens ---
# Block all env files; only the tracked template is allowed (see exception below).
.env
**/.env
*.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Distribution / packaging ---
dist/
build/
*.egg-info/
*.egg

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/

# --- Office / docs (local guides) ---
*.docx

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# --- Agent workspace (runtime data, not source) ---
agent_sessions/

agent_filesystem/input/
agent_filesystem/output/

# --- Logs ---
*.log
logs/
