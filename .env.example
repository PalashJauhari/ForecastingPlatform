# Copy to .env — do not commit .env
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: orchestrator (main agent). Default: gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Optional: internal code generation (code_pipeline tool). Default: gpt-4o-mini
# CODING_MODEL=gpt-4o-mini

# Optional: Langfuse (SDK uses LANGFUSE_HOST; if you only set LANGFUSE_BASE_URL, get_langfuse_client maps it)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
