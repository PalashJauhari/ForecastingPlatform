# ============================================================
# GaussianBlurr unified environment configuration (single file)
# ============================================================
# Copy this file to `.env` and set values.
# Keep secrets here only; do not commit `.env`.

# --------------------------
# Shared credentials
# --------------------------
OPENAI_API_KEY=""

# Optional Postgres checkpointer URL (required if MAIN_CHECKPOINTER_USE_NEON=true)
DATABASE_URL=""

# --------------------------
# Main app / graph settings
# --------------------------
MAIN_MODEL_ORCHESTRATOR="gpt-5.4-mini"
# Used by middleware/context summary helper (disabled in graph today, but configured here).
MAIN_MODEL_MESSAGE_SUMMARISATION="gpt-5.4-mini"

MAIN_GRAPH_RECURSION_LIMIT=100
MAIN_GRAPH_MAX_CONCURRENCY=2
MAIN_CHECKPOINTER_USE_NEON=false
MAIN_PATH_AGENT_FILESYSTEM="agent_filesystem"

# Context editing knobs (for summarize/truncate helper when enabled)
MAIN_CONTEXT_KEEP_RECENT_MESSAGES=10
MAIN_SUMMARY_TOKEN_THRESHOLD=100000

# Process-wide OpenAI request throttling
MAIN_RATE_LIMIT_ENABLED=true
MAIN_RATE_LIMIT_RPS=1.0
MAIN_RATE_LIMIT_CHECK_SECONDS=0.1
MAIN_RATE_LIMIT_MAX_BUCKET=5.0

# --------------------------
# Planner sub-agent settings
# --------------------------
PLANNER_MODEL="gpt-4o-mini"
# Reserved for planner subgraph thread config (currently mounted under parent graph config)
PLANNER_RECURSION_LIMIT=25
PLANNER_MAX_CONCURRENCY=2

# --------------------------
# Coding sub-agent settings
# --------------------------
CODING_MODEL="gpt-4o-mini"
# Optional stronger model for last permitted CodeGen attempt only.
CODING_MODEL_LAST_ATTEMPT=""
CODING_CODE_JUDGE_MODEL="gpt-4o-mini"
CODING_IO_JUDGE_MODEL="gpt-4o-mini"
CODING_MAX_CODEGEN_ATTEMPTS=3

CODING_E2B_API_KEY=""
CODING_E2B_TEMPLATE_NAME="forecasting-platform-ds"
CODING_E2B_TEMPLATE_ID=""
CODING_E2B_SANDBOX_TIMEOUT_SECONDS=120
CODING_E2B_EXECUTION_TIMEOUT_SECONDS=120
# false = keep sandboxes for debugging in E2B dashboard; true = kill after each run
CODING_E2B_KILL_SANDBOX=false

# --------------------------
# Observability (optional)
# --------------------------
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
# Langfuse SDK reads LANGFUSE_HOST (not LANGFUSE_BASE_URL).
LANGFUSE_HOST=https://cloud.langfuse.com
