# Copy to .env — do not commit .env
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: orchestrator (main agent). Default: gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Optional: internal code generation (generate_code tool). Default: gpt-4o-mini
# CODING_MODEL=gpt-4o-mini

# Optional: Langfuse
# LANGFUSE_PUBLIC_KEY=pk-...
# LANGFUSE_SECRET_KEY=sk-...
