# Copy to ``.env`` and fill in values. ``.env`` is gitignored — never commit it.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# OpenAI — used by the API for orchestrator, codegen, judge, summarisation, and skill selection.
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Optional — Langfuse (traces / observability)
# -----------------------------------------------------------------------------

# If you set ``LANGFUSE_BASE_URL`` but not ``LANGFUSE_HOST``, ``observability/langfuse_handler.py`` copies it into ``LANGFUSE_HOST`` for SDK compatibility.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# Optional — Postgres checkpoints (Neon / any Postgres)
# -----------------------------------------------------------------------------

# When ``config.yaml`` has ``checkpointer.use_neon: true``, set a connection URI, for example:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Optional — Dash UI only (defaults to http://127.0.0.1:8000 if unset)
# -----------------------------------------------------------------------------

# GAUSSIANBLURR_API_URL=http://127.0.0.1:8000
