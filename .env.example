# Local secrets — do not commit. See ``.env.example`` for the full list of variables.
OPENAI_API_KEY=""

LANGFUSE_TRACING_ENABLED=
# Optional: Langfuse for observability (LLM + tool traces)
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
# Langfuse SDK reads LANGFUSE_HOST (not LANGFUSE_BASE_URL).
LANGFUSE_HOST=https://cloud.langfuse.com

DATABASE_URL=""
